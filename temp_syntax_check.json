{
    "251": "            $orderBy = \"ORDER BY \n",
    "252": "                CASE LOWER(tb.dias_visitas)\n",
    "253": "                    WHEN 'lunes' THEN 1\n",
    "254": "                    WHEN 'martes' THEN 2\n",
    "255": "                    WHEN 'miercoles' THEN 3\n",
    "256": "                    WHEN 'jueves' THEN 4\n",
    "257": "                    WHEN 'viernes' THEN 5\n",
    "258": "                    WHEN 'sabado' THEN 6\n",
    "259": "                    WHEN 'domingo' THEN 7\n",
    "260": "                    ELSE 8 END DESC,\n",
    "261": "                tb.fecha_emision DESC,\n",
    "262": "                CAST(tb.id_ruta AS UNSIGNED) DESC,\n",
    "263": "                CAST(CASE WHEN tb.mercado IS NULL OR tb.mercado = '' THEN 999 ELSE tb.mercado END AS UNSIGNED) ASC\";\n",
    "264": "                SELECT \r\n",
    "265": "                    'c' AS tipo_co,\r\n",
    "266": "                    co.cotizacion_id AS id_venta,\r\n",
    "267": "                    CONCAT('#', co.numero) AS factura,\r\n",
    "268": "                    us.usuario AS vendedor,\r\n",
    "269": "                    co.fecha AS fecha_emision,\r\n",
    "270": "                    (SELECT fecha FROM cuotas_cotizacion cc WHERE cc.id_coti = co.cotizacion_id ORDER BY fecha DESC LIMIT 1) AS fecha_vencimiento,\r\n",
    "271": "                    CONCAT(c.documento, ' | ', c.datos) AS cliente,\r\n",
    "272": "                    co.total,\r\n",
    "273": "                    c.mercado AS mercado,\n",
    "274": "                    c.dias_visitas,\n",
    "275": "                    c.id_ruta,\n"
}